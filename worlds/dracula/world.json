      "trigger": {
        "onEnter": true
      },
      "cooldownSec": 180,
      "lines": [
        {
          "who": "mina",
          "text": "Good evening, {player}. Come near the lamp; it grows very cold in the Pass.",
          "waitMs": 4000
        },
        {
          "who": "mina",
          "text": "Do you hear the wolves? Jonathan heard them here too.",
          "waitMs": 2500
        }
      ]
    },
    {
      "id": "van-helsing-welcome",
      "room": "ruined-chapel",
      "trigger": {
        "onEnter": true
      },
      "cooldownSec": 180,
      "lines": [
        {
          "who": "van-helsing",
          "text": "Ah, {player}! Tread soft. This earth in the boxes, it is not of the common.",
          "waitMs": 4000
        },
        {
          "who": "van-helsing",
          "text": "We learn from failure, not from success!",
          "waitMs": 2500
        }
      ]
    },
    {
      "id": "library-parting",
      "room": "castle-library",
      "trigger": {
        "play": true
      },
      "cooldownSec": 600,
      "lines": [
        {
          "who": "jonathan",
          "text": "Why may I not go to-night?",
          "waitMs": 4000
        },
        {
          "who": "dracula",
          "text": "Because, dear sir, my coachman and horses are away on a mission.",
          "waitMs": 3000
        },
        {
          "who": "jonathan",
          "text": "But I would walk with pleasure. I want to get away at once.",
          "waitMs": 3000
        },
        {
          "who": "dracula",
          "text": "And your baggage?",
          "waitMs": 2500
        },
        {
          "who": "jonathan",
          "text": "I do not care about it. I can send for it some other time.",
          "waitMs": 3000
        }
      ]
    },
    {
      "id": "pass-meeting",
      "room": "borgo-pass",
      "trigger": {
        "play": true
      },
      "cooldownSec": 600,
      "lines": [
        {
          "who": "van-helsing",
          "text": "Madam Mina, it is on account of the dead I come.",
          "waitMs": 4000
        },
        {
          "who": "mina",
          "text": "Sir, you could have no better claim on me than that you were a friend and helper of Lucy Westenra.",
          "waitMs": 3000
        },
        {
          "who": "van-helsing",
          "text": "Ah, then you have good memory for facts, for details? It is not always so with young ladies.",
          "waitMs": 3000
        },
        {
          "who": "mina",
          "text": "No, doctor, but I wrote it all down at the time.",
          "waitMs": 2500
        },
        {
          "who": "van-helsing",
          "text": "Oh, you so clever woman! Alas! I know not the shorthand.",
          "waitMs": 3000
        }
      ]
