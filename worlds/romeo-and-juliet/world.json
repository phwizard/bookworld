  "scripts": [
    {
      "id": "greet-mercutio",
      "room": "verona-square",
      "trigger": {
        "onEnter": true
      },
      "cooldownSec": 180,
      "lines": [
        {
          "who": "mercutio",
          "text": "Signior {player}, bonjour! Come, we burn daylight, ho.",
          "waitMs": 4000
        },
        {
          "who": "mercutio",
          "text": "Men's eyes were made to look, and let them gaze. I will not budge for no man's pleasure, I.",
          "waitMs": 3500
        }
      ]
    },
    {
      "id": "greet-nurse",
      "room": "capulet-hall",
      "trigger": {
        "onEnter": true
      },
      "cooldownSec": 180,
      "lines": [
        {
          "who": "nurse",
          "text": "God ye good morrow, {player}! Anon, anon!",
          "waitMs": 4000
        },
        {
          "who": "nurse",
          "text": "Faith, I can tell her age unto an hour. Come Lammas Eve at night shall she be fourteen.",
          "waitMs": 3500
        }
      ]
    },
    {
      "id": "greet-romeo",
      "room": "capulet-orchard",
      "trigger": {
        "onEnter": true
      },
      "cooldownSec": 180,
      "lines": [
        {
          "who": "romeo",
          "text": "He jests at scars that never felt a wound.",
          "waitMs": 4000
        },
        {
          "who": "romeo",
          "text": "Soft, {player}, speak low. The orchard walls are high and hard to climb, and the place death if any of her kinsmen find us here.",
          "waitMs": 3500
        }
      ]
    },
    {
      "id": "greet-juliet",
      "room": "juliet-chamber",
      "trigger": {
        "onEnter": true
      },
      "cooldownSec": 180,
      "lines": [
        {
          "who": "juliet",
          "text": "How now, who calls? Is it {player}?",
          "waitMs": 4000
        },
        {
          "who": "juliet",
          "text": "What's in a name? That which we call a rose by any other name would smell as sweet.",
          "waitMs": 3500
        }
      ]
    },
    {
      "id": "scene-feast",
      "room": "capulet-hall",
      "trigger": {
        "play": true
      },
      "cooldownSec": 600,
      "lines": [
        {
          "who": "romeo",
          "text": "O, she doth teach the torches to burn bright! It seems she hangs upon the cheek of night as a rich jewel in an Ethiop's ear.",
          "waitMs": 4000
        },
        {
          "who": "romeo",
          "text": "What is her mother?",
          "waitMs": 4000
        },
        {
          "who": "nurse",
          "text": "Marry, bachelor, her mother is the lady of the house, and a good lady, and a wise and virtuous.",
          "waitMs": 3500
        },
        {
          "who": "nurse",
          "text": "I nurs'd her daughter that you talk'd withal. I tell you, he that can lay hold of her shall have the chinks.",
          "waitMs": 4500
        },
        {
          "who": "romeo",
          "text": "Is she a Capulet? O dear account! My life is my foe's debt.",
          "waitMs": 4500
        }
      ]
    },
    {
      "id": "scene-balcony",
      "room": "capulet-orchard",
      "trigger": {
        "play": true
      },
      "cooldownSec": 600,
      "lines": [
        {
          "who": "romeo",
          "text": "But soft, what light through yonder window breaks? It is the east, and Juliet is the sun!",
          "waitMs": 4000
        },
        {
          "who": "juliet",
          "text": "O Romeo, Romeo, wherefore art thou Romeo? Deny thy father and refuse thy name.",
          "waitMs": 4500
        },
        {
          "who": "romeo",
          "text": "I take thee at thy word. Call me but love, and I'll be new baptis'd.",
          "waitMs": 4500
        },
        {
          "who": "juliet",
          "text": "Good night, good night. Parting is such sweet sorrow that I shall say good night till it be morrow.",
          "waitMs": 4500
        },
        {
          "who": "romeo",
          "text": "Sleep dwell upon thine eyes, peace in thy breast.",
          "waitMs": 4500
        }
      ]
    },
    {
      "id": "scene-noon",
      "room": "verona-square",
      "trigger": {
        "play": true
      },
      "cooldownSec": 600,
      "lines": [
        {
          "who": "nurse",
          "text": "God ye good morrow, gentlemen.",
          "waitMs": 4000
        },
        {
          "who": "mercutio",
          "text": "God ye good-den, fair gentlewoman.",
          "waitMs": 3000
        },
        {
          "who": "nurse",
          "text": "Is it good-den?",
          "waitMs": 3000
        },
        {
          "who": "mercutio",
          "text": "'Tis no less, I tell ye; for the bawdy hand of the dial is now upon the prick of noon.",
          "waitMs": 3500
        },
        {
          "who": "nurse",
          "text": "Out upon you! What a man are you?",
          "waitMs": 4000
        }
      ]
    },
    {
      "id": "scene-news",
      "room": "juliet-chamber",
      "trigger": {
        "play": true
      },
      "cooldownSec": 600,
      "lines": [
        {
          "who": "juliet",
          "text": "Ay me, what news? Why dost thou wring thy hands?",
          "waitMs": 4000
        },
        {
          "who": "nurse",
          "text": "Tybalt is gone, and Romeo banished. Romeo that kill'd him, he is banished.",
          "waitMs": 4000
        },
        {
          "who": "juliet",
          "text": "O God! Did Romeo's hand shed Tybalt's blood?",
          "waitMs": 4000
        },
        {
          "who": "nurse",
          "text": "Will you speak well of him that kill'd your cousin?",
          "waitMs": 4000
        },
        {
          "who": "juliet",
          "text": "Shall I speak ill of him that is my husband?",
          "waitMs": 4000
        }
      ]
    },
    {
      "id": "scene-cell",
      "room": "friar-cell",
      "trigger": {
        "play": true
      },
      "cooldownSec": 600,
      "lines": [
        {
          "who": "nurse",
          "text": "Stand up, stand up; stand, and you be a man. For Juliet's sake, for her sake, rise and stand.",
          "waitMs": 4000
        },
        {
          "who": "romeo",
          "text": "Spakest thou of Juliet? How is it with her?",
          "waitMs": 4000
        },
        {
          "who": "nurse",
          "text": "O, she says nothing, sir, but weeps and weeps; and Tybalt calls, and then on Romeo cries.",
          "waitMs": 4000
        },
        {
          "who": "nurse",
          "text": "Here sir, a ring she bid me give you, sir. Hie you, make haste, for it grows very late.",
          "waitMs": 4500
        },
        {
          "who": "romeo",
          "text": "How well my comfort is reviv'd by this.",
          "waitMs": 4000
        }
      ]
    },
    {
      "id": "scene-farewell",
      "room": "mantua",
      "trigger": {
        "play": true
      },
      "cooldownSec": 600,
      "lines": [
        {
          "who": "juliet",
          "text": "O thinkest thou we shall ever meet again?",
          "waitMs": 4000
        },
        {
          "who": "romeo",
          "text": "I doubt it not, and all these woes shall serve for sweet discourses in our time to come.",
          "waitMs": 4000
        },
        {
          "who": "juliet",
          "text": "O God! I have an ill-divining soul! Methinks I see thee, now thou art so low, as one dead in the bottom of a tomb.",
          "waitMs": 4500
        },
        {
          "who": "romeo",
          "text": "Dry sorrow drinks our blood. Adieu, adieu.",
          "waitMs": 4500
        },
        {
          "who": "romeo",
          "text": "If I may trust the flattering eye of sleep, my dreams presage some joyful news at hand.",
          "waitMs": 5000
        }
      ]
    },
    {
      "id": "scene-tomb",
      "room": "capulet-tomb",
      "trigger": {
        "play": true
      },
      "cooldownSec": 600,
      "lines": [
        {
          "who": "romeo",
          "text": "Here lies Juliet, and her beauty makes this vault a feasting presence full of light.",
          "waitMs": 4000
        },
        {
          "who": "romeo",
          "text": "Eyes, look your last. Arms, take your last embrace! Here's to my love! Thus with a kiss I die.",
          "waitMs": 4500
        },
        {
          "who": "juliet",
          "text": "O comfortable Friar, where is my lord? I do remember well where I should be, and there I am. Where is my Romeo?",
          "waitMs": 5000
        },
        {
          "who": "juliet",
          "text": "What's here? A cup clos'd in my true love's hand? Thy lips are warm!",
          "waitMs": 4500
        }
      ]
    }
  ]
}
