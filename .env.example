# Ethora Cloud (public SaaS). Self-hosted Ethora Core users point these at their own install.
ETHORA_API_BASE_URL=https://api.chat.ethora.com/v1
ETHORA_XMPP_DOMAIN=
# One Ethora App per world. Create it in the Ethora admin or via the MCP (ethora-app-create).
ETHORA_APP_ID=
# App token for the world service (server side only; never shipped to the client, never committed).
ETHORA_APP_TOKEN=
# World service (Colyseus) public URL for the client
VITE_WORLD_SERVER_URL=ws://localhost:2567
