# Ethora Cloud (public SaaS). Self-hosted Ethora Core users point these at their own install.
ETHORA_API_BASE_URL=https://api.chat.ethora.com/v1
ETHORA_XMPP_DOMAIN=xmpp.chat.ethora.com
# App Secret of the Ethora App for this world (web dashboard > app > API tab). Server side only, never committed.
# The world service signs B2B server tokens and per-guest client tokens with it (via @ethora/sdk-backend).
# Without it the server runs in "no chat" mode: movement works, chat and narration are off.
ETHORA_CHAT_APP_SECRET=
# One world, one Ethora App: a second world gets its own secret as ETHORA_CHAT_APP_SECRET_<SLUG> (e.g. ETHORA_CHAT_APP_SECRET_TEMPEST)
# Secret for this project's own session tokens (any long random string). Random per boot when unset.
BOOKWORLD_SESSION_SECRET=
# World service (Colyseus) port, bind address (unset = every interface, for LAN play; production uses 127.0.0.1 behind Caddy)
# and allowed browser origins (comma separated, * for all)
PORT=2567
HOST=
CORS_ORIGIN=*
# Folder with worlds/<slug>/world.json (default: ../worlds relative to server/)
WORLDS_DIR=
# Client: public URL of the world service. Leave unset to use the host that served the page, port 2567
# (works for localhost and for other devices on the same network); set it when the service runs elsewhere.
# VITE_WORLD_SERVER_URL=https://play.example.com

# Usage report: event log location (default server/data/events.jsonl; "off" disables) and the token that unlocks GET /api/metrics (unset = endpoint off)
METRICS_FILE=
METRICS_TOKEN=
# Debug log for development: every event with its text (joins, moves, chords, lesson rounds, what the service posts, the room's chat
# as the clients see it, Ethora errors). "on" writes DATA_DIR/debug/<world>-<date>.jsonl, a path writes that file. Off when unset.
# The chat text is in it, so only on your own test server, and off again afterwards.
DEBUG_LOG=

# Character voices rendered on the server (docs/VOICES.md). Off = the browser's own speech synthesis.
# VOICE_BACKEND=command runs VOICE_COMMAND with placeholders {text} {out} {voice} {sample} {description} {lang}, one argument each:
#   voice/say.sh {voice} {out} {text}                                     (macOS, development)
#   voice/.venv/bin/python voice/render.py --sample {sample} --out {out} --lang {lang} --text {text}   (cloned voices)
# VOICE_BACKEND=openai needs OPENAI_API_KEY (model VOICE_OPENAI_MODEL, default gpt-4o-mini-tts); VOICE_BACKEND=elevenlabs needs
# ELEVENLABS_API_KEY and a voice.ids.elevenlabs per character. VOICE_DAILY_CHARS caps rendered text per world per day (0 = no cap).
VOICE_BACKEND=
VOICE_COMMAND=
# Singing (docs/VOICES.md): the renderer that sings a song line in the character's voice through VOICE_COMMAND
# VOICE_SING=voice/.venv/bin/python voice/sing.py
VOICE_SING=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
VOICE_DAILY_CHARS=200000

# Generator (pnpm generate): Anthropic API key, or leave empty to use the Claude Code CLI on this machine (`claude -p`)
ANTHROPIC_API_KEY=
# Model for the API backend (default claude-opus-5-5)
GENERATOR_MODEL=
# Provisioner (pnpm provision): a user API key for the hosted Ethora MCP server (ethora-api-key-create; sent as Authorization: Bearer)
ETHORA_API_KEY=
ETHORA_MCP_URL=https://mcp.chat.ethora.com/mcp

# Daily cap on paid AI use. Character replies per world per day (0 = unlimited) and per visitor per day;
# at the world limit the characters rest until the reset (5-field cron, UTC). State lives in DATA_DIR/ai-budget.json.
# With ETHORA_API_KEY set the agents themselves are switched off at the limit; without it only the clients stop addressing them.
AI_DAILY_LIMIT=500
AI_DAILY_LIMIT_PER_PLAYER=60
AI_DAILY_RESET=0 0 * * *
# Generator: runs and dollars per day (0 = unlimited); the API backend estimates dollars from tokens with GENERATOR_USD_PER_MTOK "<in>,<out>"
GENERATOR_DAILY_RUNS=5
GENERATOR_DAILY_USD=10
GENERATOR_USD_PER_MTOK=15,75
# Folder for the event log and the budget file (default server/data)
DATA_DIR=

# "Make your own world" form on the join screen: on by default when ANTHROPIC_API_KEY is set; MAKE_WORLD=off disables it.
# MAKE_WORLD_ALLOW_CLI=on lets it use the Claude Code CLI on this machine instead (your own account; never on a public server).
MAKE_WORLD=
MAKE_WORLD_ALLOW_CLI=

# Deploy target for the team test server (docs/DEPLOY.md, deploy/push.sh). Host and user live only in .env, never in git;
# the production settings go in .env.production (written once by deploy/make-env.sh, also gitignored).
DEPLOY_HOST=
DEPLOY_USER=root
