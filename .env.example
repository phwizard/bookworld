# Ethora Cloud (public SaaS). Self-hosted Ethora Core users point these at their own install.
ETHORA_API_BASE_URL=https://api.chat.ethora.com/v1
ETHORA_XMPP_DOMAIN=xmpp.chat.ethora.com
# App Secret of the Ethora App for this world (web dashboard > app > API tab). Server side only, never committed.
# The world service signs B2B server tokens and per-guest client tokens with it (via @ethora/sdk-backend).
# Without it the server runs in "no chat" mode: movement works, chat and narration are off.
ETHORA_CHAT_APP_SECRET=
# One world, one Ethora App: a second world gets its own secret as ETHORA_CHAT_APP_SECRET_<SLUG> (e.g. ETHORA_CHAT_APP_SECRET_TEMPEST)
# Secret for this project's own session tokens (any long random string). Random per boot when unset.
BOOKWORLD_SESSION_SECRET=
# World service (Colyseus) port and allowed browser origins (comma separated, * for all)
PORT=2567
CORS_ORIGIN=*
# Folder with worlds/<slug>/world.json (default: ../worlds relative to server/)
WORLDS_DIR=
# Client: public URL of the world service
VITE_WORLD_SERVER_URL=http://localhost:2567

# Usage report: event log location (default server/data/events.jsonl; "off" disables) and the token that unlocks GET /api/metrics (unset = endpoint off)
METRICS_FILE=
METRICS_TOKEN=

# Generator (pnpm generate): Anthropic API key, or leave empty to use the Claude Code CLI on this machine (`claude -p`)
ANTHROPIC_API_KEY=
# Model for the API backend (default claude-opus-5-5)
GENERATOR_MODEL=
# Provisioner (pnpm provision): a user API key for the hosted Ethora MCP server (ethora-api-key-create; sent as Authorization: Bearer)
ETHORA_API_KEY=
ETHORA_MCP_URL=https://mcp.chat.ethora.com/mcp

# Daily cap on paid AI use. Character replies per world per day (0 = unlimited) and per visitor per day;
# at the world limit the characters rest until the reset (5-field cron, UTC). State lives in DATA_DIR/ai-budget.json.
# With ETHORA_API_KEY set the agents themselves are switched off at the limit; without it only the clients stop addressing them.
AI_DAILY_LIMIT=500
AI_DAILY_LIMIT_PER_PLAYER=60
AI_DAILY_RESET=0 0 * * *
# Generator: runs and dollars per day (0 = unlimited); the API backend estimates dollars from tokens with GENERATOR_USD_PER_MTOK "<in>,<out>"
GENERATOR_DAILY_RUNS=5
GENERATOR_DAILY_USD=10
GENERATOR_USD_PER_MTOK=15,75
# Folder for the event log and the budget file (default server/data)
DATA_DIR=
