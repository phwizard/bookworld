node_modules/
dist/
build/
.env
.env.*
!.env.example
*.log
.DS_Store
# generated assets and world exports with real tokens never go in git
worlds/*/secrets.json
/tmp/
# per-world Ethora ids and tokens (filled by provisioning)
worlds/*/ethora.json

# usage event log (server/data/events.jsonl) and players' lesson progress (server/data/progress) stay local
server/data/
# song files whose words are in copyright stay on your machine (pnpm song -- --private)
worlds/*/songs/private/

# generator working files: the book text, the knowledge chunks and the model's raw draft are reproducible from world.json's source field
worlds/*/source/
worlds/*/knowledge/
worlds/*/draft.json
worlds/*/world.invalid.json
generator/.cache/

# local voice renderer environment and its output
voice/.venv/
voice/out/
