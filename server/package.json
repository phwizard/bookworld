{
  "name": "@bookworld/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../.env --import tsx --watch src/index.ts",
    "start": "node --env-file=../.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate:worlds": "tsx src/world/validate-cli.ts ../worlds",
    "metrics": "tsx src/metrics-cli.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@bookworld/generator": "workspace:*",
    "@bookworld/shared": "workspace:*",
    "@colyseus/core": "^0.18.19",
    "@colyseus/schema": "^5.0.40",
    "@colyseus/ws-transport": "^0.18.4",
    "@ethora/sdk-backend": "^26.8.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cors": "^2.8.6",
    "croner": "^10.0.1",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3"
  }
}
